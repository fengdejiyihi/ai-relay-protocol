{
  "rsp": "1.0",
  "supplier": {
    "name": "示例摘要服务",
    "description": "Python SDK 的 L2 异步示例：接单后在后台生成摘要，完成后回调 Relay，也支持补拉和取消。",
    "locale": "zh-CN",
    "categories": ["写作", "示例"],
    "user_binding": "none"
  },
  "endpoint": { "url": "https://summarizer.example.com/relay", "auth": "hmac-sha256" },
  "actions": [
    {
      "name": "summarize",
      "title": "生成摘要",
      "description": "给一段文字生成摘要，几秒后通过回调返回。",
      "input": {
        "type": "object",
        "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 20000 } },
        "required": ["text"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": { "summary": { "type": "string" } },
        "required": ["summary"]
      },
      "risk": "medium",
      "confirm": "by_grant",
      "mode": "async",
      "billing": "on_complete",
      "fee": 100,
      "amount": "none",
      "timeout_seconds": 600
    }
  ]
}
